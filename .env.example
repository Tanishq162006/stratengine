# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...

# Model choices
STRATENGINE_EXTRACT_MODEL=claude-sonnet-4-6
STRATENGINE_SYNTH_MODEL=claude-sonnet-4-6
STRATENGINE_CRITIC_MODEL=claude-sonnet-4-6
STRATENGINE_CODER_MODEL=claude-sonnet-4-6

# Storage
STRATENGINE_DB_PATH=./stratengine.db
STRATENGINE_CHROMA_PATH=./.chroma

# Crawler
STRATENGINE_USER_AGENT=StratEngineBot/0.1 (+https://github.com/Tanishq162006/stratengine)
STRATENGINE_RATE_LIMIT_PER_HOST=1.0  # requests per second per host
STRATENGINE_MAX_CONCURRENCY=4
